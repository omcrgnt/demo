<mxfile host="app.diagrams.net">
  <diagram name="Registry delivery" id="registry-delivery">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- center: registry circle -->
        <mxCell id="reg" value="&lt;b&gt;res.Registry&lt;/b&gt;&lt;br&gt;центральное хранилище" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="360" y="360" width="120" height="120" as="geometry"/>
        </mxCell>

        <!-- ① top: Config → Builder (-90°) -->
        <mxCell id="p1" value="&lt;b&gt;① Config → Builder&lt;/b&gt;&lt;br&gt;&lt;br&gt;AppResources / ecfg&lt;br&gt;Configurable → BuildConfig()&lt;br&gt;builder.Build() → config.Build()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="80" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p1" target="reg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1l" value="resource" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e1">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- ② bottom-right: Resourcer (+30°) -->
        <mxCell id="p2" value="&lt;b&gt;② Resourcer&lt;/b&gt;&lt;br&gt;&lt;br&gt;generic Builder-config [T]&lt;br&gt;T.BuildResource()&lt;br&gt;skip if not Resourcer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;" vertex="1" parent="1">
          <mxGeometry x="560" y="520" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2" target="reg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2l" value="prototype" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e2">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- ③ bottom-left: use init (+150°) -->
        <mxCell id="p3" value="&lt;b&gt;③ use init&lt;/b&gt;&lt;br&gt;&lt;br&gt;AddWithTags(default)&lt;br&gt;config → путь ①&lt;br&gt;resource → сразу в pool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p3" target="reg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3l" value="config / resource" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e3">
          <mxGeometry x="-0.1" y="1" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry>
        </mxCell>

        <!-- optional: pipeline after -->
        <mxCell id="after" value="obs.Transform → sdi.Resolve → runner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="285" y="540" width="270" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ea" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="reg" target="after">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
